# devplatform — every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs; the deploy provides
# exactly those. `src/env.ts` is the single place they are named in code, and `env.test.ts` asserts
# that this file and that file agree in BOTH directions — a variable here that nothing reads fails
# the suite just as loudly as one that is read and not declared.
#
# ─── EVERY SECRET BELOW IS `CHANGE_ME`, AND `CHANGE_ME` DOES NOT BOOT ─────────────────────────────
#
# That is enforced, not advisory: `env.ts` refuses a known placeholder outright and refuses anything
# shorter than 24 characters. A default secret in source is not convenient, it is catastrophic, and
# a placeholder that boots is a placeholder that reaches production.
#
# Generate real ones with:  openssl rand -hex 32
#
# ─── WHAT THIS SERVICE DELIBERATELY HAS NO VARIABLE FOR ──────────────────────────────────────────
#
# There is no DEVPLATFORM_ADMIN_TOKEN, no break-glass credential and no reveal switch. The
# equivalent here would be a static string that can read or issue credentials, which is the shape of
# the omnipotent service tokens SD-05 exists to retire. `env.test.ts` asserts their absence by name.
#
# There is no public API base URL either. The gateway decides where this service is mounted
# (deploy/gateway/dynamic/public-api.yml), and a URL configured here would be one this service
# invented. See the README.

# ─── the service ─────────────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# The image tag, stamped by the deploy. Appears on every log line as `version`.
CLOUDSFORGE_TAG=dev
# Identifies this replica in `jobs.locked_by`. Defaults to the hostname, which is right in a
# container and wrong on a laptop running two copies.
INSTANCE_ID=devplatform-local

# ─── the one database ────────────────────────────────────────────────────────────────────────────
# Rule 1: one database, named by this service's own variable. CI greps for any other
# `*_DATABASE_URL` token in source, so a second one fails the build rather than review.
DEVPLATFORM_DATABASE_URL=postgres://devplatform:CHANGE_ME_DB_PASSWORD@postgres:5432/devplatform
DEVPLATFORM_DATABASE_POOL_MAX=10

# ─── identity ────────────────────────────────────────────────────────────────────────────────────
# Used for two things: verifying the developer's JWT, and asking identity who is a member of an
# organisation. The membership call forwards the DEVELOPER'S OWN token, so this service holds no
# credential that can read anybody's membership — see src/membership.ts.
IDENTITY_JWKS_URL=http://identity:4000/.well-known/jwks.json
IDENTITY_ISSUER=http://identity:4000

# ─── signing ─────────────────────────────────────────────────────────────────────────────────────
# Secrets accepted on POST /v1/events, the internal inbox, newest first.
#
# A LIST, not a value, because rotation without an overlap window means every producer must change
# secret in the same instant this service does — and that instant does not exist during a rolling
# deploy. Comma-separated; duplicates are refused, because a duplicated secret makes "which key
# verified this" ambiguous, and that answer is what tells an operator a rotation has finished.
#
#   openssl rand -base64 48
#
# The boot guard checks the SHAPE of each entry rather than a list of known-bad strings: base64 or
# hex only (no hyphens — every placeholder this estate ever wrote had one), at least 32 DECODED
# BYTES rather than 24 keystrokes, and a measured entropy floor. So a typed value is refused however
# long it is, and there is no NODE_ENV exemption (micro-org #142). Every entry of the list faces
# that same bar, including the one on its way OUT of a rotation.
DEVPLATFORM_INGEST_SECRETS=CHANGE_ME_run_openssl_rand_base64_48

# Signs this service's OWN outbox deliveries to internal subscribers. Same shape check, same
# command: openssl rand -base64 48
OUTBOX_SIGNING_SECRET=CHANGE_ME_run_openssl_rand_base64_48

# ─── quotas ──────────────────────────────────────────────────────────────────────────────────────
# The defaults a NEW project's environments are seeded with. Not a ceiling: `quotas` rows are per
# environment and an operator raises one with a PUT rather than a deploy.
#
# Zero is not expressible, here or in the schema. A quota of zero is a project that cannot make a
# request, which is a suspension — and a suspension is a status on the organisation, not a limit.
DEVPLATFORM_DEFAULT_QUOTA_PER_MINUTE=600
DEVPLATFORM_DEFAULT_QUOTA_PER_MONTH=1000000

# ─── webhooks ────────────────────────────────────────────────────────────────────────────────────
# How long a rotated signing secret keeps verifying. The default is 24 hours: long enough for a
# customer to notice, deploy and roll back, which is the operation the overlap exists for.
#
# Named ROTATION_OVERLAP rather than SECRET_OVERLAP because it is a DURATION, and the estate's
# secret-hygiene check reads any `*SECRET*` variable with a value as a credential somebody pasted in
# and forgot. That check is right — a value that does not say it is fake should be treated as real —
# so the variable was renamed rather than the guard relaxed.
DEVPLATFORM_WEBHOOK_ROTATION_OVERLAP_MINUTES=1440
# Deadline on one delivery POST. A slow subscriber must not hold a job lease open long enough for a
# second worker to claim the same delivery.
DEVPLATFORM_WEBHOOK_DEADLINE_MS=5000
# Attempts before a delivery is abandoned. The row is RETAINED rather than deleted — it is the only
# durable record that a customer was sent an event and never took it.
DEVPLATFORM_WEBHOOK_MAX_ATTEMPTS=8

# ─── retention ───────────────────────────────────────────────────────────────────────────────────
# Raw usage events are pruned once rolled up; the rollups are what survive. The rollup horizon must
# be at least the event horizon — `env.ts` refuses the inversion — because a summary thrown away
# while its inputs survive is the opposite of what a rollup is for, and because
# 11-data-and-contract-strategy.md:304 commits to notifying every project that called an endpoint in
# the last 90 days, which only the rollups can answer.
DEVPLATFORM_USAGE_EVENT_RETENTION_DAYS=35
DEVPLATFORM_USAGE_ROLLUP_RETENTION_DAYS=400
